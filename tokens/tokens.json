{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Escalas decididas del frontend-design-kit (espacio, radio, sombra, tipo fluido, tracking, leading, motion, breakpoints, z-index). Foto del 2026-11-19, America/Argentina/Salta. El color semántico vive en ../paletas/paletas.json: este archivo no impone un acento. Formato Design Tokens Community Group 2025.10 (informe final del 28 de octubre de 2025). No es una recomendación W3C; es el informe estable del Community Group.",
  "spacing": {
    "$description": "Escala de 4 px (0.25rem) con pasos nombrados. Prohibido inventar gaps de 13 o 18 px. En Tailwind v4, --spacing: 0.25rem hace que p-4 = 1rem; los nombres de acá son la escala que un agente debería usar, no todos los enteros posibles.",
    "0": {
      "$type": "dimension",
      "$value": {
        "value": 0,
        "unit": "rem"
      }
    },
    "1": {
      "$type": "dimension",
      "$value": {
        "value": 0.25,
        "unit": "rem"
      }
    },
    "2": {
      "$type": "dimension",
      "$value": {
        "value": 0.5,
        "unit": "rem"
      }
    },
    "3": {
      "$type": "dimension",
      "$value": {
        "value": 0.75,
        "unit": "rem"
      }
    },
    "4": {
      "$type": "dimension",
      "$value": {
        "value": 1,
        "unit": "rem"
      }
    },
    "5": {
      "$type": "dimension",
      "$value": {
        "value": 1.25,
        "unit": "rem"
      }
    },
    "6": {
      "$type": "dimension",
      "$value": {
        "value": 1.5,
        "unit": "rem"
      }
    },
    "8": {
      "$type": "dimension",
      "$value": {
        "value": 2,
        "unit": "rem"
      }
    },
    "10": {
      "$type": "dimension",
      "$value": {
        "value": 2.5,
        "unit": "rem"
      }
    },
    "12": {
      "$type": "dimension",
      "$value": {
        "value": 3,
        "unit": "rem"
      }
    },
    "16": {
      "$type": "dimension",
      "$value": {
        "value": 4,
        "unit": "rem"
      }
    },
    "20": {
      "$type": "dimension",
      "$value": {
        "value": 5,
        "unit": "rem"
      }
    },
    "24": {
      "$type": "dimension",
      "$value": {
        "value": 6,
        "unit": "rem"
      }
    },
    "32": {
      "$type": "dimension",
      "$value": {
        "value": 8,
        "unit": "rem"
      }
    },
    "section-sm": {
      "$type": "dimension",
      "$value": {
        "value": 4,
        "unit": "rem"
      }
    },
    "section": {
      "$type": "dimension",
      "$value": {
        "value": 6,
        "unit": "rem"
      }
    },
    "section-lg": {
      "$type": "dimension",
      "$value": {
        "value": 8,
        "unit": "rem"
      }
    }
  },
  "radius": {
    "$description": "Elegí UN default por proyecto (casi siempre md = 6px). xl queda para recortes de media, no para cada card. none es válido y a menudo mejor (suizo, brutal, catálogo).",
    "none": {
      "$type": "dimension",
      "$value": {
        "value": 0,
        "unit": "px"
      }
    },
    "sm": {
      "$type": "dimension",
      "$value": {
        "value": 2,
        "unit": "px"
      }
    },
    "md": {
      "$type": "dimension",
      "$value": {
        "value": 6,
        "unit": "px"
      }
    },
    "lg": {
      "$type": "dimension",
      "$value": {
        "value": 10,
        "unit": "px"
      }
    },
    "xl": {
      "$type": "dimension",
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "full": {
      "$type": "dimension",
      "$value": {
        "value": 9999,
        "unit": "px"
      }
    }
  },
  "shadow": {
    "$description": "Poca sombra. El borde de bajo contraste define mejor el chasis que un shadow-xl. glow de acento no es un token de elevación: si hace falta, es un caso puntual, no una escala.",
    "none": {
      "$type": "shadow",
      "$value": {
        "color": {
          "colorSpace": "oklch",
          "components": [
            0,
            0,
            0
          ],
          "alpha": 0,
          "hex": "#000000"
        },
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 0,
          "unit": "px"
        },
        "blur": {
          "value": 0,
          "unit": "px"
        },
        "spread": {
          "value": 0,
          "unit": "px"
        },
        "inset": false
      },
      "$description": "Sin sombra. Preferila frente a un shadow suave 'por si acaso'."
    },
    "xs": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 1,
            "unit": "px"
          },
          "blur": {
            "value": 2,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          },
          "color": {
            "colorSpace": "oklch",
            "components": [
              0,
              0,
              0
            ],
            "alpha": 0.06,
            "hex": "#000000"
          },
          "inset": false
        }
      ]
    },
    "sm": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 1,
            "unit": "px"
          },
          "blur": {
            "value": 3,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          },
          "color": {
            "colorSpace": "oklch",
            "components": [
              0,
              0,
              0
            ],
            "alpha": 0.08,
            "hex": "#000000"
          },
          "inset": false
        }
      ]
    },
    "md": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 8,
            "unit": "px"
          },
          "blur": {
            "value": 24,
            "unit": "px"
          },
          "spread": {
            "value": -8,
            "unit": "px"
          },
          "color": {
            "colorSpace": "oklch",
            "components": [
              0,
              0,
              0
            ],
            "alpha": 0.12,
            "hex": "#000000"
          },
          "inset": false
        }
      ]
    },
    "lg": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 24,
            "unit": "px"
          },
          "blur": {
            "value": 48,
            "unit": "px"
          },
          "spread": {
            "value": -12,
            "unit": "px"
          },
          "color": {
            "colorSpace": "oklch",
            "components": [
              0,
              0,
              0
            ],
            "alpha": 0.18,
            "hex": "#000000"
          },
          "inset": false
        }
      ]
    }
  },
  "fontSize": {
    "$description": "Escala fluida con clamp(), viewport 320–1240 px. El cuerpo va de 16 a 18 px. Calculada al estilo Utopia (utopia.fyi). En CSS vive como custom properties; acá se documenta el valor de viewport mínimo (el clamp completo está en tokens.css).",
    "caption": {
      "$type": "dimension",
      "$value": {
        "value": 0.8125,
        "unit": "rem"
      }
    },
    "sm": {
      "$type": "dimension",
      "$value": {
        "value": 0.875,
        "unit": "rem"
      }
    },
    "body": {
      "$type": "dimension",
      "$value": {
        "value": 1,
        "unit": "rem"
      }
    },
    "lg": {
      "$type": "dimension",
      "$value": {
        "value": 1.125,
        "unit": "rem"
      }
    },
    "h4": {
      "$type": "dimension",
      "$value": {
        "value": 1.25,
        "unit": "rem"
      }
    },
    "h3": {
      "$type": "dimension",
      "$value": {
        "value": 1.5,
        "unit": "rem"
      }
    },
    "h2": {
      "$type": "dimension",
      "$value": {
        "value": 1.875,
        "unit": "rem"
      }
    },
    "h1": {
      "$type": "dimension",
      "$value": {
        "value": 2.5,
        "unit": "rem"
      }
    },
    "display": {
      "$type": "dimension",
      "$value": {
        "value": 3,
        "unit": "rem"
      }
    }
  },
  "fontSizeFluid": {
    "$description": "Los clamp() listos. $type string porque el formato 2025.10 no tiene un tipo 'css-expression'. El valor canónico para agentes que escriben CSS.",
    "caption": {
      "$type": "string",
      "$value": "clamp(0.8125rem, 0.7908rem + 0.1087vw, 0.8750rem)"
    },
    "sm": {
      "$type": "string",
      "$value": "clamp(0.8750rem, 0.8533rem + 0.1087vw, 0.9375rem)"
    },
    "body": {
      "$type": "string",
      "$value": "clamp(1.0000rem, 0.9565rem + 0.2174vw, 1.1250rem)"
    },
    "lg": {
      "$type": "string",
      "$value": "clamp(1.1250rem, 1.0815rem + 0.2174vw, 1.2500rem)"
    },
    "h4": {
      "$type": "string",
      "$value": "clamp(1.2500rem, 1.1630rem + 0.4348vw, 1.5000rem)"
    },
    "h3": {
      "$type": "string",
      "$value": "clamp(1.5000rem, 1.3696rem + 0.6522vw, 1.8750rem)"
    },
    "h2": {
      "$type": "string",
      "$value": "clamp(1.8750rem, 1.6576rem + 1.0870vw, 2.5000rem)"
    },
    "h1": {
      "$type": "string",
      "$value": "clamp(2.5000rem, 2.1522rem + 1.7391vw, 3.5000rem)"
    },
    "display": {
      "$type": "string",
      "$value": "clamp(3.0000rem, 2.4783rem + 2.6087vw, 4.5000rem)"
    }
  },
  "lineHeight": {
    "$description": "Multiplicadores, no px. Display y h1 van cerrados; el cuerpo, abierto. La IA suele poner leading-tight en párrafos o leading-normal en un display.",
    "display": {
      "$type": "number",
      "$value": 1.05
    },
    "heading": {
      "$type": "number",
      "$value": 1.15
    },
    "tight": {
      "$type": "number",
      "$value": 1.25
    },
    "body": {
      "$type": "number",
      "$value": 1.5
    },
    "body-lg": {
      "$type": "number",
      "$value": 1.6
    },
    "mono": {
      "$type": "number",
      "$value": 1.4
    }
  },
  "letterSpacing": {
    "$description": "em, no px. tracking-widest solo para un kicker, no para cada h2. El abuso de labels en mayúsculas con letter-spacing enorme es un tell (ver anti-patrones).",
    "tighter": {
      "$type": "dimension",
      "$value": {
        "value": -0.03,
        "unit": "em"
      }
    },
    "tight": {
      "$type": "dimension",
      "$value": {
        "value": -0.02,
        "unit": "em"
      }
    },
    "normal": {
      "$type": "dimension",
      "$value": {
        "value": 0,
        "unit": "em"
      }
    },
    "wide": {
      "$type": "dimension",
      "$value": {
        "value": 0.04,
        "unit": "em"
      }
    },
    "widest": {
      "$type": "dimension",
      "$value": {
        "value": 0.16,
        "unit": "em"
      }
    }
  },
  "duration": {
    "$description": "Corto y de salida. Nada de duration-1000 ni de fade-in en cada sección. Respetá prefers-reduced-motion (ver tokens.css).",
    "instant": {
      "$type": "duration",
      "$value": {
        "value": 0,
        "unit": "ms"
      }
    },
    "fast": {
      "$type": "duration",
      "$value": {
        "value": 120,
        "unit": "ms"
      }
    },
    "base": {
      "$type": "duration",
      "$value": {
        "value": 180,
        "unit": "ms"
      }
    },
    "slow": {
      "$type": "duration",
      "$value": {
        "value": 280,
        "unit": "ms"
      }
    },
    "deliberate": {
      "$type": "duration",
      "$value": {
        "value": 400,
        "unit": "ms"
      }
    }
  },
  "easing": {
    "$description": "Curvas de salida, al estilo de las --ease-fluid y --ease-snappy que Tailwind v4 muestra en sus docs. Sin bounce. Sin ease-in-out genérico en todo.",
    "standard": {
      "$type": "cubicBezier",
      "$value": [
        0.2,
        0,
        0,
        1
      ]
    },
    "emphasized": {
      "$type": "cubicBezier",
      "$value": [
        0.3,
        0,
        0,
        1
      ]
    },
    "enter": {
      "$type": "cubicBezier",
      "$value": [
        0.16,
        1,
        0.3,
        1
      ]
    },
    "exit": {
      "$type": "cubicBezier",
      "$value": [
        0.4,
        0,
        1,
        1
      ]
    }
  },
  "breakpoint": {
    "$description": "Los defaults de Tailwind v4, en rem (1rem = 16px). sm 40rem, md 48rem, lg 64rem, xl 80rem, 2xl 96rem. Un 3xl (120rem) es opcional y no es default.",
    "sm": {
      "$type": "dimension",
      "$value": {
        "value": 40,
        "unit": "rem"
      }
    },
    "md": {
      "$type": "dimension",
      "$value": {
        "value": 48,
        "unit": "rem"
      }
    },
    "lg": {
      "$type": "dimension",
      "$value": {
        "value": 64,
        "unit": "rem"
      }
    },
    "xl": {
      "$type": "dimension",
      "$value": {
        "value": 80,
        "unit": "rem"
      }
    },
    "2xl": {
      "$type": "dimension",
      "$value": {
        "value": 96,
        "unit": "rem"
      }
    }
  },
  "zIndex": {
    "$description": "Capas nombradas. Prohibido z-[9999], z-99 y pelearse a golpes de número. Si necesitás un slot nuevo, nombraló en este grupo; no lo inventes en el componente.",
    "base": {
      "$type": "number",
      "$value": 0
    },
    "raised": {
      "$type": "number",
      "$value": 10
    },
    "dropdown": {
      "$type": "number",
      "$value": 20
    },
    "sticky": {
      "$type": "number",
      "$value": 30
    },
    "overlay": {
      "$type": "number",
      "$value": 40
    },
    "modal": {
      "$type": "number",
      "$value": 50
    },
    "toast": {
      "$type": "number",
      "$value": 60
    },
    "max": {
      "$type": "number",
      "$value": 70
    }
  }
}
