  "checklist": [
    {
      "id": "F-01",
      "area": "Flujo",
      "texto": "La tarea principal de cada pantalla se entiende en 5 segundos y tiene una sola acción primaria.",
      "severidad_si_falla": 3,
      "archivo": "fundamentos.md",
      "refs": [
        "H8"
      ]
    },
    {
      "id": "F-02",
      "area": "Flujo",
      "texto": "Se sabe dónde estoy, qué pasó y qué sigue (estado visible, paso actual, ítem activo).",
      "severidad_si_falla": 3,
      "archivo": "heuristicas.md",
      "refs": [
        "H1"
      ]
    },
    {
      "id": "F-03",
      "area": "Flujo",
      "texto": "Toda acción reversible tiene deshacer; lo irreversible pide confirmación específica con verbo.",
      "severidad_si_falla": 4,
      "archivo": "feedback-notificaciones.md",
      "refs": [
        "H3",
        "H5"
      ]
    },
    {
      "id": "F-04",
      "area": "Flujo",
      "texto": "El botón Atrás del navegador funciona; filtros, pestañas y páginas viven en la URL.",
      "severidad_si_falla": 3,
      "archivo": "arquitectura-informacion-navegacion.md",
      "refs": [
        "H3"
      ]
    },
    {
      "id": "F-05",
      "area": "Flujo",
      "texto": "No se pierde trabajo: borradores, campos que no se vacían, aviso antes de expirar la sesión.",
