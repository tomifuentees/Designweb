  "leyes": [
    {
      "id": "jakob",
      "nombre": "Ley de Jakob",
      "aplicacion": "Usá convenciones en navegación, carrito, login y formularios; diferenciá en contenido y marca.",
      "evidencia": "Observacional (NN/g).",
      "archivo": "fundamentos.md"
    },
    {
      "id": "hick",
      "nombre": "Ley de Hick",
      "aplicacion": "Menos opciones visibles, opción recomendada, divulgación progresiva.",
      "evidencia": "Experimentos de tiempo de reacción (1952); no escala lineal a menús escaneables.",
      "archivo": "fundamentos.md"
    },
    {
      "id": "fitts",
      "nombre": "Ley de Fitts",
      "aplicacion": "Objetivos grandes y cerca del punto de partida; esquinas y bordes en desktop.",
      "evidencia": "Muy robusta; base de WCAG 2.5.8.",
      "archivo": "fundamentos.md"
    },
    {
      "id": "miller",
      "nombre": "Ley de Miller",
      "aplicacion": "No hagas recordar datos entre pantallas; agrupá en chunks.",
      "evidencia": "Mal citada; Cowan (2001) estima ~4 chunks; no limita menús a 7.",
      "archivo": "fundamentos.md"
    },
    {
      "id": "tesler",
      "nombre": "Ley de Tesler",
      "aplicacion": "Que el sistema absorba la complejidad (deducir, autocompletar).",
      "evidencia": "Principio de diseño.",
      "archivo": "fundamentos.md"
    },
    {
      "id": "doherty",
      "nombre": "Umbral de Doherty",
      "aplicacion": "Feedback <100 ms; respuesta <400 ms; INP ≤200 ms.",
      "evidencia": "Paper de IBM 1982.",
      "archivo": "fundamentos.md"
    },
    {
      "id": "peak-end",
      "nombre": "Regla pico-final",
      "aplicacion": "Cuidá el peor momento y la confirmación final.",
      "evidencia": "Kahneman et al. 1993; extrapolación a productos razonable.",
      "archivo": "fundamentos.md"
    },
    {
      "id": "postel",
      "nombre": "Ley de Postel",
      "aplicacion": "Aceptá formatos variados (espacios, guiones, mayúsculas).",
      "evidencia": "Principio de ingeniería.",
      "archivo": "fundamentos.md"
    },
    {
      "id": "goal-gradient",
      "nombre": "Gradiente de meta",
      "aplicacion": "Progreso visible y real en onboarding y multipaso.",
      "evidencia": "Kivetz et al. 2006.",
      "archivo": "fundamentos.md"
    },
    {
      "id": "zeigarnik",
      "nombre": "Efecto Zeigarnik",
      "aplicacion": "Checklists de activación y borradores, sin culpa.",
      "evidencia": "Replicación mixta.",
      "archivo": "fundamentos.md"
    },
    {
      "id": "serial-position",
      "nombre": "Posición serial",
      "aplicacion": "Lo clave al principio y al final de listas y navegaciones.",
      "evidencia": "Robusto en memoria de listas.",
      "archivo": "fundamentos.md"
    },
    {
      "id": "von-restorff",
      "nombre": "Efecto Von Restorff",
      "aplicacion": "Un solo acento para la acción primaria (no solo por color).",
      "evidencia": "Robusto.",
      "archivo": "fundamentos.md"
    },
    {
      "id": "aesthetic-usability",
      "nombre": "Estético-usable",
      "aplicacion": "La terminación visual suma, pero tapa problemas en tests.",
      "evidencia": "Kurosu y Kashimura 1995; M3 Expressive 2025–2026.",
      "archivo": "fundamentos.md"
    },
    {
      "id": "choice-overload",
      "nombre": "Sobrecarga de opciones",
      "aplicacion": "Comparadores, recomendados, filtros.",
      "evidencia": "Replicaciones débiles; depende del contexto.",
      "archivo": "fundamentos.md"
    },
    {
      "id": "active-user",
      "nombre": "Paradoja del usuario activo",
      "aplicacion": "Ayuda en contexto, no manuales ni tours largos.",
      "evidencia": "Carroll y Rosson 1987.",
      "archivo": "fundamentos.md"
    },
    {
      "id": "cognitive-load",
      "nombre": "Carga cognitiva",
      "aplicacion": "Reconocer > recordar, defaults, un foco por pantalla.",
      "evidencia": "Sweller.",
      "archivo": "fundamentos.md"
    },
    {
      "id": "gestalt",
      "nombre": "Gestalt (proximidad, región común, similitud, conexión, Prägnanz)",
      "aplicacion": "Ver layout/jerarquia-composicion.md.",
      "evidencia": "Robusta.",
      "archivo": "fundamentos.md"
    },
    {
      "id": "pareto",
      "nombre": "Pareto",
      "aplicacion": "Optimizá primero los flujos más frecuentes.",
      "evidencia": "Heurística.",
      "archivo": "fundamentos.md"
    },
    {
      "id": "selective-attention",
      "nombre": "Atención selectiva / ceguera de banners",
      "aplicacion": "Lo crítico inline, no en banners promocionales.",
      "evidencia": "Eye tracking (NN/g).",
      "archivo": "fundamentos.md"
    },
    {
      "id": "parkinson",
      "nombre": "Ley de Parkinson",
      "aplicacion": "Autocompletar y checkout exprés acortan la tarea.",
      "evidencia": "Heurística.",
      "archivo": "fundamentos.md"
    },
    {
      "id": "occam",
      "nombre": "Navaja de Occam",
      "aplicacion": "La solución con menos partes móviles.",
      "evidencia": "Heurística.",
      "archivo": "fundamentos.md"
    },
    {
      "id": "mental-model",
      "nombre": "Modelo mental",
      "aplicacion": "Investigá antes de inventar un modelo nuevo.",
      "evidencia": "NN/g.",
      "archivo": "fundamentos.md"
    },
    {
      "id": "flow",
      "nombre": "Flow",
      "aplicacion": "Sin interrupciones en tareas largas.",
      "evidencia": "Csikszentmihalyi.",
      "archivo": "fundamentos.md"
    }
  ],
